# Optional. Without a key, scans open a practice N2 page you can edit.
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional alias accepted by the OCR / JLPT routes.
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override. JLPT analyzer defaults to gemini-3.5-flash-lite (fast).
# GEMINI_MODEL=gemini-3.5-flash-lite
# JLPT_GEMINI_MODEL=gemini-3.5-flash-lite
# Grammar / ★ analyzer defaults to gemini-2.5-flash.
# GRAMMAR_GEMINI_MODEL=gemini-2.5-flash
